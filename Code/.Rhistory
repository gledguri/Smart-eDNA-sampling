for (i in seq_len(n)) {
a <- ring_km[i, ]
b <- ring_km[i %% n + 1, ]
if (sqrt(sum((a - b)^2)) < 1e-6) stop("Remove repeated neighbouring corners.")
for (j in seq_len(n)) {
is_neighbour <- j == i || j == i %% n + 1 || i == j %% n + 1
if (is_neighbour || j < i) next
if (edges_touch(a, b, ring_km[j, ], ring_km[j %% n + 1, ])) {
stop("The boundary crosses or touches itself. Use a simple outline.")
}
}
}
}
create_survey_area <- function(gps_corners, excluded_areas = NULL) {
all_gps <- c(list(gps_corners), excluded_areas)
for (gps in all_gps) {
if (!all(c("lat", "lon") %in% names(gps))) stop("Each table needs columns `lat` and `lon`.")
if (any(!is.finite(c(gps$lat, gps$lon))) || any(abs(gps$lat) > 80)) {
stop("Use finite latitudes and longitudes, between 80S and 80N.")
}
}
# Let areas that cross the 180-degree meridian work: measure every longitude
# relative to the first corner.
first_lon <- gps_corners$lon[1]
all_gps <- lapply(all_gps, function(gps) {
gps$lon <- first_lon + ((gps$lon - first_lon + 180) %% 360) - 180
gps
})
center    <- c(mean(all_gps[[1]]$lat), mean(all_gps[[1]]$lon))
rings_km  <- lapply(all_gps, convert_gps_to_km, center = center)
check_ring(rings_km[[1]], max_corners = 200)
for (hole in rings_km[-1]) {
check_ring(hole, max_corners = 200)
if (!all(is_inside_ring(hole, rings_km[[1]]))) stop("Excluded areas must lie inside the outline.")
}
area_km2 <- calc_ring_area(rings_km[[1]]) -
sum(vapply(rings_km[-1], calc_ring_area, numeric(1)))
if (area_km2 < min_area_km2) {
stop("This area covers only ", round(area_km2), " km2. Use at least ", min_area_km2, " km2.")
}
n_field_points <- max(1, ceiling(area_km2 * field_points_per_10000_km2 / 10000))
if (n_field_points > max_field_points) {
stop("This area needs ", n_field_points, " field points, but the maximum is ",
max_field_points, ". Use an area of at most 1,000,000 km2.")
}
all_xy <- do.call(rbind, rings_km)
list(
gps_corners    = gps_corners,
center         = center,                      # c(lat, lon) of the projection
rings_km       = rings_km,                    # outline first, then excluded areas
bounds_km      = c(xmin = min(all_xy[, 1]), xmax = max(all_xy[, 1]),
ymin = min(all_xy[, 2]), ymax = max(all_xy[, 2])),
area_km2       = area_km2,
n_field_points = n_field_points
)
}
# Quick picture of the area, to check you typed your coordinates correctly.
plot_survey_area <- function(area) {
outline <- do.call(rbind, lapply(seq_along(area$rings_km), function(i) {
ring <- area$rings_km[[i]]
data.frame(x = c(ring[, 1], ring[1, 1]), y = c(ring[, 2], ring[1, 2]), ring = i)
}))
ggplot(outline, aes(x, y, group = ring)) +
geom_path(colour = "#006d77", linewidth = 0.8) +
coord_equal() +
labs(title = "Survey area",
subtitle = paste0(format(round(area$area_km2), big.mark = ","), " km2"),
x = "Local easting (km)", y = "Local northing (km)") +
theme_minimal()
}
# ----- EXAMPLE, Part I -------------------------------------------------------
# Replace these corners with your own GPS coordinates (decimal degrees, in order
# around the edge). This example is a stretch of the US West Coast.
gps_corners <- data.frame(
lat = c(48.4, 48.4, 38.4, 38.4, 40.4, 43.0, 46.2, 48.2),
lon = c(-124.7, -126.4, -126.0, -123.5, -124.4, -124.5, -124.1, -124.6)
)
gps_corners
# Optional: islands or land to leave out, one table per island (or NULL for none).
excluded_areas <- NULL
area <- create_survey_area(gps_corners, excluded_areas)
cat("Survey area:", round(area$area_km2), "km2\n")
plot_survey_area(area)
# =============================================================================
# eDNA survey planner (R version of eDNA_survey_planner_v4.html)
# =============================================================================
# How to use this script
#   Run it from top to bottom. Every part has its functions first and then a
#   short EXAMPLE. In each example, the input values are written right there,
#   so change them in place and re-run that example.
#
#   Part I   - Create a survey area from GPS coordinates
#   Part II  - How many samples do I need?  (from rho and epsilon)
#   Part III - Simulate a "true" GP field   (from rho, sigma, alpha, mu)
#   Part IV  - Pick the survey samples and rebuild the map from them
#   Part V   - Four plots (same as "See your survey in action" in the web page)
#
# Words used below
#   rho     (km)  patchiness: how far apart two places can be and still be similar
#   epsilon       target prediction error on the log scale (smaller = sharper map)
#   alpha         spatial variance (how strongly concentrations vary across space)
#   sigma         noise SD of a single observation (log scale)
#   mu            average log concentration, ln(copies/L)
#   density       samples per 10,000 km2 (for one depth layer)
#
# Random numbers: R's generator is not the same as the web page's, so a given
# seed gives a different (but equally valid) random field than in the browser.
# The maths is the same as in the web page.
# =============================================================================
library(ggplot2)
# -----------------------------------------------------------------------------
# Settings copied from the web page
# -----------------------------------------------------------------------------
# Coefficients of the fitted equation:
#   log(epsilon) = omega + beta*log(E) + theta*log(rho) + gamma*log(E)*log(rho)
default_coefficients <- c(omega = 1.65, beta = -0.176, theta = -0.228, gamma = -0.0684)
# The equation was fitted inside these ranges. Outside them we still calculate,
# but we warn that the answer is an extrapolation.
rho_range     <- c(25, 1000)   # km
density_range <- c(1.5, 20)    # samples per 10,000 km2
field_points_per_10000_km2 <- 40     # size of the simulated "true" field
max_field_points           <- 4000   # = largest area of 1,000,000 km2
min_area_km2               <- 1000   # smallest area allowed
grid_spacing_km            <- 5      # the error map is evaluated on a 5 x 5 km grid
earth_radius_km            <- 6371.0088
# =============================================================================
# PART I. Create a survey area from GPS coordinates
# =============================================================================
# Input: a table of corners with columns `lat` and `lon`, in order around the
#        edge of your area (do not repeat the first corner at the end).
#        Optional: `excluded_areas`, a list of such tables for islands or land.
# Output: a list describing the area (corners, size in km2, how many points the
#         simulated field will have, ...).
# Turn latitude/longitude into flat x/y distances in km. We use an equal-area
# projection centred on `center` = c(lat, lon), so areas stay correct.
convert_gps_to_km <- function(gps, center) {
lat      <- gps$lat * pi / 180
center_lat <- center[1] * pi / 180
lon_diff <- (gps$lon - center[2]) * pi / 180
denominator <- 1 + sin(center_lat) * sin(lat) + cos(center_lat) * cos(lat) * cos(lon_diff)
if (any(denominator < 1e-8)) stop("This area is too wide for a regional projection.")
scale <- sqrt(2 / denominator)
x <- earth_radius_km * scale * cos(lat) * sin(lon_diff)
y <- earth_radius_km * scale * (cos(center_lat) * sin(lat) -
sin(center_lat) * cos(lat) * cos(lon_diff))
cbind(x = x, y = y)
}
# Area (km2) inside a ring of x/y corners ("shoelace formula").
calc_ring_area <- function(ring_km) {
x <- ring_km[, 1]
y <- ring_km[, 2]
next_corner <- c(2:nrow(ring_km), 1)
abs(sum(x * y[next_corner] - x[next_corner] * y)) / 2
}
# Which points lie inside a single ring? (ray-casting test: a point is inside
# if a line going right from it crosses the edge an odd number of times)
is_inside_ring <- function(points_km, ring_km) {
inside <- rep(FALSE, nrow(points_km))
previous <- nrow(ring_km)
for (current in seq_len(nrow(ring_km))) {
ax <- ring_km[current, 1];  ay <- ring_km[current, 2]
bx <- ring_km[previous, 1]; by <- ring_km[previous, 2]
crosses <- ((ay > points_km[, 2]) != (by > points_km[, 2])) &
(points_km[, 1] < (bx - ax) * (points_km[, 2] - ay) / (by - ay) + ax)
inside <- xor(inside, crosses)
previous <- current
}
inside
}
# Which points lie inside the whole survey area (inside the outline, and not
# inside any excluded island)?
is_inside_area <- function(points_km, area) {
inside <- is_inside_ring(points_km, area$rings_km[[1]])
for (hole in area$rings_km[-1]) {
inside <- inside & !is_inside_ring(points_km, hole)
}
inside
}
# Do the straight edges a-b and c-d cross or touch each other?
edges_touch <- function(a, b, c, d) {
turn <- function(p, q, r) (q[1] - p[1]) * (r[2] - p[2]) - (q[2] - p[2]) * (r[1] - p[1])
lies_on_edge <- function(p, q, r) {
abs(turn(p, q, r)) < 1e-8 &&
r[1] >= min(p[1], q[1]) - 1e-8 && r[1] <= max(p[1], q[1]) + 1e-8 &&
r[2] >= min(p[2], q[2]) - 1e-8 && r[2] <= max(p[2], q[2]) + 1e-8
}
crossing <- turn(a, b, c) * turn(a, b, d) < 0 && turn(c, d, a) * turn(c, d, b) < 0
crossing || lies_on_edge(a, b, c) || lies_on_edge(a, b, d) ||
lies_on_edge(c, d, a) || lies_on_edge(c, d, b)
}
# Stop with a clear message if a ring is not a clean, simple shape.
check_ring <- function(ring_km, max_corners) {
n <- nrow(ring_km)
if (n < 3 || n > max_corners) stop("Use between 3 and ", max_corners, " corners per outline.")
if (max(dist(ring_km)) > 2000) stop("Use a regional area spanning at most 2,000 km.")
for (i in seq_len(n)) {
a <- ring_km[i, ]
b <- ring_km[i %% n + 1, ]
if (sqrt(sum((a - b)^2)) < 1e-6) stop("Remove repeated neighbouring corners.")
for (j in seq_len(n)) {
is_neighbour <- j == i || j == i %% n + 1 || i == j %% n + 1
if (is_neighbour || j < i) next
if (edges_touch(a, b, ring_km[j, ], ring_km[j %% n + 1, ])) {
stop("The boundary crosses or touches itself. Use a simple outline.")
}
}
}
}
create_survey_area <- function(gps_corners, excluded_areas = NULL) {
all_gps <- c(list(gps_corners), excluded_areas)
for (gps in all_gps) {
if (!all(c("lat", "lon") %in% names(gps))) stop("Each table needs columns `lat` and `lon`.")
if (any(!is.finite(c(gps$lat, gps$lon))) || any(abs(gps$lat) > 80)) {
stop("Use finite latitudes and longitudes, between 80S and 80N.")
}
}
# Let areas that cross the 180-degree meridian work: measure every longitude
# relative to the first corner.
first_lon <- gps_corners$lon[1]
all_gps <- lapply(all_gps, function(gps) {
gps$lon <- first_lon + ((gps$lon - first_lon + 180) %% 360) - 180
gps
})
center    <- c(mean(all_gps[[1]]$lat), mean(all_gps[[1]]$lon))
rings_km  <- lapply(all_gps, convert_gps_to_km, center = center)
check_ring(rings_km[[1]], max_corners = 200)
for (hole in rings_km[-1]) {
check_ring(hole, max_corners = 200)
if (!all(is_inside_ring(hole, rings_km[[1]]))) stop("Excluded areas must lie inside the outline.")
}
area_km2 <- calc_ring_area(rings_km[[1]]) -
sum(vapply(rings_km[-1], calc_ring_area, numeric(1)))
if (area_km2 < min_area_km2) {
stop("This area covers only ", round(area_km2), " km2. Use at least ", min_area_km2, " km2.")
}
n_field_points <- max(1, ceiling(area_km2 * field_points_per_10000_km2 / 10000))
if (n_field_points > max_field_points) {
stop("This area needs ", n_field_points, " field points, but the maximum is ",
max_field_points, ". Use an area of at most 1,000,000 km2.")
}
all_xy <- do.call(rbind, rings_km)
list(
gps_corners    = gps_corners,
center         = center,                      # c(lat, lon) of the projection
rings_km       = rings_km,                    # outline first, then excluded areas
bounds_km      = c(xmin = min(all_xy[, 1]), xmax = max(all_xy[, 1]),
ymin = min(all_xy[, 2]), ymax = max(all_xy[, 2])),
area_km2       = area_km2,
n_field_points = n_field_points
)
}
# Quick picture of the area, to check you typed your coordinates correctly.
plot_survey_area <- function(area) {
outline <- do.call(rbind, lapply(seq_along(area$rings_km), function(i) {
ring <- area$rings_km[[i]]
data.frame(x = c(ring[, 1], ring[1, 1]), y = c(ring[, 2], ring[1, 2]), ring = i)
}))
ggplot(outline, aes(x, y, group = ring)) +
geom_path(colour = "#006d77", linewidth = 0.8) +
coord_equal() +
labs(title = "Survey area",
subtitle = paste0(format(round(area$area_km2), big.mark = ","), " km2"),
x = "Local easting (km)", y = "Local northing (km)") +
theme_minimal()
}
# ----- EXAMPLE, Part I -------------------------------------------------------
# Replace these corners with your own GPS coordinates (decimal degrees, in order
# around the edge). This example is a stretch of the US West Coast.
gps_corners <- data.frame(
lat = c(48.4, 48.4, 38.4, 38.4, 40.4, 43.0, 46.2, 48.2),
lon = c(-124.7, -126.4, -126.0, -123.5, -124.4, -124.5, -124.1, -124.6)
)
# Optional: islands or land to leave out, one table per island (or NULL for none).
excluded_areas <- NULL
# excluded_areas <- list(data.frame(lat = c(46.5, 46.5, 46.3), lon = c(-125.5, -125.2, -125.3)))
plot_survey_area(area)
calc_samples_needed <- function(rho, epsilon, area_km2, depth_layers = 1,
coefficients = default_coefficients) {
if (!all(is.finite(c(rho, epsilon, area_km2))) || any(c(rho, epsilon, area_km2) <= 0)) {
stop("rho, epsilon and area_km2 must be positive numbers.")
}
# The fitted equation is log(epsilon) = a + b * log(density), so we solve it for density.
a <- coefficients[["omega"]] + coefficients[["theta"]] * log(rho)
b <- coefficients[["beta"]]  + coefficients[["gamma"]] * log(rho)
if (b >= -1e-8) stop("These coefficients do not give a decreasing error curve.")
samples_per_10000_km2 <- exp((log(epsilon) - a) / b)
samples_per_depth     <- max(1, ceiling(samples_per_10000_km2 * area_km2 / 10000 - 1e-10))
# Tell the user if we are outside the range where the equation was fitted.
notes <- character(0)
if (rho < rho_range[1] || rho > rho_range[2]) {
notes <- c(notes, "rho is outside the fitted 25-1,000 km range.")
}
if (samples_per_10000_km2 > density_range[2]) {
notes <- c(notes, "Density is above the fitted maximum of 20: this is an extrapolation.")
}
if (samples_per_10000_km2 < density_range[1]) {
notes <- c(notes, "Density is below the fitted minimum of 1.5: this is an extrapolation.")
}
list(
rho                   = rho,
epsilon               = epsilon,
area_km2              = area_km2,
samples_per_10000_km2 = samples_per_10000_km2,         # E
samples_per_depth     = samples_per_depth,             # N / H
depth_layers          = depth_layers,                  # H
total_samples         = samples_per_depth * depth_layers,  # N
notes                 = if (length(notes)) notes else "Inside the fitted range."
)
}
# ----- EXAMPLE, Part II ------------------------------------------------------
rho          <- 100    # patchiness in km (25 = very patchy, 1000 = very smooth)
epsilon      <- 0.8    # target prediction error (log scale, 0.05 to 3)
depth_layers <- 1      # only multiplies the total
plan <- calc_samples_needed(rho, epsilon, area$area_km2, depth_layers)
print(plan)
# Try several targets at once: what does a sharper map cost?
for (try_epsilon in c(0.4, 0.8, 1.2)) {
try_plan <- calc_samples_needed(rho, try_epsilon, area$area_km2)
cat("epsilon =", try_epsilon, "->", round(try_plan$samples_per_10000_km2, 2),
"samples per 10,000 km2,", try_plan$samples_per_depth, "samples in total\n")
}
# Covariance between every row of `points_a` and every row of `points_b`.
calc_covariance <- function(points_a, points_b, rho, alpha) {
squared_distance <- outer(points_a[, 1], points_b[, 1], "-")^2 +
outer(points_a[, 2], points_b[, 2], "-")^2
alpha * exp(-squared_distance / (2 * rho^2))
}
# Cholesky factor of the observation covariance (spatial part + noise sigma^2).
# A tiny extra number on the diagonal keeps the maths numerically stable.
calc_cholesky <- function(points_km, rho, sigma, alpha) {
jitter <- 1e-10 * max(alpha + sigma^2, 1)
covariance <- calc_covariance(points_km, points_km, rho, alpha) +
diag(sigma^2 + jitter, nrow(points_km))
chol(covariance)    # upper-triangular R, where covariance = t(R) %*% R
}
# Spread n random points evenly over the area (skipping islands).
draw_random_points <- function(area, n) {
bounds <- area$bounds_km
points <- matrix(numeric(0), ncol = 2)
for (attempt in 1:1000) {
candidates <- cbind(runif(n * 2, bounds["xmin"], bounds["xmax"]),
runif(n * 2, bounds["ymin"], bounds["ymax"]))
points <- rbind(points, candidates[is_inside_area(candidates, area), , drop = FALSE])
if (nrow(points) >= n) return(points[seq_len(n), , drop = FALSE])
}
stop("This very thin area could not be sampled. Use a more compact area.")
}
simulate_gp_field <- function(area, rho, sigma, alpha, mu, seed = 317) {
if (any(!is.finite(c(rho, sigma, alpha, mu))) || alpha <= 0 || rho <= 0 || sigma < 0) {
stop("Use finite mu, positive alpha and rho, and non-negative sigma.")
}
set.seed(seed)
points_km <- draw_random_points(area, area$n_field_points)
cholesky  <- calc_cholesky(points_km, rho, sigma, alpha)
# Draw one random field: mu + (covariance factor) x (standard normal noise).
log_concentration <- mu + as.vector(t(cholesky) %*% rnorm(nrow(points_km)))
# "Weights" let us evaluate the full-data GP surface anywhere later.
weights <- backsolve(cholesky, backsolve(cholesky, log_concentration - mu, transpose = TRUE))
list(
points_km         = points_km,
log_concentration = log_concentration,    # ln(copies/L) at each point
weights           = weights,
settings          = list(rho = rho, sigma = sigma, alpha = alpha, mu = mu, seed = seed)
)
}
# Small helper used in Parts III and IV: value of a GP surface at any `places`,
# given the observations (`points_km`) and their `weights`.
predict_gp_surface <- function(places_km, points_km, weights, rho, alpha, mu) {
surface <- numeric(nrow(places_km))
chunk_size <- 2000       # work in pieces so large areas do not run out of memory
for (start in seq(1, nrow(places_km), by = chunk_size)) {
rows <- start:min(start + chunk_size - 1, nrow(places_km))
surface[rows] <- mu + calc_covariance(places_km[rows, , drop = FALSE], points_km, rho, alpha) %*% weights
}
surface
}
# ----- EXAMPLE, Part III -----------------------------------------------------
rho   <- 100    # patchiness (km); use the same value as in Part II
sigma <- 3      # noise SD of each observation (log scale)
alpha <- 4      # spatial variance
mu    <- 4.61   # average ln(copies/L); ln(100) = 4.61
seed  <- 317    # change it to get a different random field
field <- simulate_gp_field(area, rho, sigma, alpha, mu, seed)
cat("Simulated", nrow(field$points_km), "observations\n")
# Randomly choose `n_samples` of the simulated observations (no repeats).
select_survey_samples <- function(field, n_samples, seed = 911) {
if (n_samples < 1 || n_samples > nrow(field$points_km)) {
stop("The survey needs ", n_samples, " samples but only ", nrow(field$points_km),
" simulated observations exist. Increase epsilon to ask for fewer samples.")
}
set.seed(seed)
sample.int(nrow(field$points_km), n_samples)    # row numbers of the chosen points
}
# Centres of the 5 x 5 km grid cells that lie inside the area.
make_evaluation_grid <- function(area) {
b <- area$bounds_km
x_centres <- b["xmin"] + grid_spacing_km / 2 +
grid_spacing_km * (0:(max(1, ceiling((b["xmax"] - b["xmin"]) / grid_spacing_km)) - 1))
y_centres <- b["ymin"] + grid_spacing_km / 2 +
grid_spacing_km * (0:(max(1, ceiling((b["ymax"] - b["ymin"]) / grid_spacing_km)) - 1))
grid <- as.matrix(expand.grid(x = x_centres, y = y_centres))
grid[is_inside_area(grid, area), , drop = FALSE]
}
# Build both maps and compare them.
reconstruct_map <- function(area, field, survey_rows) {
s <- field$settings
# Reference map: uses every simulated observation.
grid <- make_evaluation_grid(area)
reference <- predict_gp_surface(grid, field$points_km, field$weights, s$rho, s$alpha, s$mu)
# Inferred map: uses only the survey samples. Same formula as GP.stan:
#   inferred = mu + K(grid, samples) %*% solve(K(samples, samples) + sigma^2 I) %*% (observed - mu)
sample_points <- field$points_km[survey_rows, , drop = FALSE]
cholesky      <- calc_cholesky(sample_points, s$rho, s$sigma, s$alpha)
observed      <- field$log_concentration[survey_rows] - s$mu
weights       <- backsolve(cholesky, backsolve(cholesky, observed, transpose = TRUE))
inferred      <- predict_gp_surface(grid, sample_points, weights, s$rho, s$alpha, s$mu)
# Prediction error at each grid cell, and over the whole area.
error <- sqrt((inferred - reference)^2)
list(
grid              = data.frame(x = grid[, 1], y = grid[, 2],
reference = reference, inferred = inferred, error = error),
measured_epsilon  = sqrt(mean((inferred - reference)^2)),
survey_rows       = survey_rows,
n_grid_cells      = nrow(grid)
)
}
# ----- EXAMPLE, Part IV ------------------------------------------------------
n_samples   <- plan$samples_per_depth   # recommended samples from Part II
survey_seed <- 911                      # change it to reshuffle which points are kept
survey_rows <- select_survey_samples(field, n_samples, survey_seed)
result      <- reconstruct_map(area, field, survey_rows)
cat("Survey samples:", length(survey_rows), "of", nrow(field$points_km), "simulated observations\n")
cat("Target epsilon:  ", epsilon, "\n")
cat("Measured epsilon:", round(result$measured_epsilon, 3), "\n")
# Shared look of the three maps.
draw_map <- function(area, grid, values, colours, legend_title, title, subtitle) {
outlines <- do.call(rbind, lapply(seq_along(area$rings_km), function(i) {
ring <- area$rings_km[[i]]
data.frame(x = c(ring[, 1], ring[1, 1]), y = c(ring[, 2], ring[1, 2]), ring = i)
}))
ggplot() +
geom_tile(data = grid, aes(x, y, fill = values), width = grid_spacing_km, height = grid_spacing_km) +
geom_path(data = outlines, aes(x, y, group = ring), colour = "grey35", linewidth = 0.4) +
scale_fill_gradientn(colours = colours, name = legend_title) +
coord_equal() +
labs(title = title, subtitle = subtitle, x = "Local easting (km)", y = "Local northing (km)") +
theme_minimal() +
theme(legend.position = "bottom", legend.key.width = grid::unit(1.5, "cm"))
}
# Add white-outlined circles for observation points.
add_points <- function(map, points_km) {
map + geom_point(data = data.frame(x = points_km[, 1], y = points_km[, 2]), aes(x, y),
shape = 21, fill = NA, colour = "white", stroke = 0.4, size = 1.4)
}
concentration_colours <- c("#193466", "#197589", "#5db59c", "#efdd6c")   # dark blue -> yellow
error_colours         <- c("#fff4d2", "#f9a45b", "#ca4237", "#6b163b")   # cream -> dark red
# Plot 1: the simulated reference field (built from all observations).
plot_reference_field <- function(area, field, result, show_points = TRUE) {
map <- draw_map(area, result$grid, result$grid$reference, concentration_colours,
"ln(copies/L)", "1. Simulated reference field",
paste0("GP surface from all ", nrow(field$points_km), " observations"))
if (show_points) map <- add_points(map, field$points_km)
map
}
plot_reference_field
# Plot 2: the inferred field (built from the survey samples only).
plot_inferred_field <- function(area, field, result, show_points = TRUE) {
map <- draw_map(area, result$grid, result$grid$inferred, concentration_colours,
"ln(copies/L)", "2. Inferred field from the survey",
paste0("GP surface from ", length(result$survey_rows), " survey samples"))
if (show_points) map <- add_points(map, field$points_km[result$survey_rows, , drop = FALSE])
map
}
# Plot 3: prediction error map (difference between plots 1 and 2).
plot_error_map <- function(area, result) {
draw_map(area, result$grid, result$grid$error, error_colours,
"error (log scale)", "3. Prediction error map",
"Error at each place = sqrt((inferred - reference)^2)")
}
# Plot 4: distribution of the prediction errors, with target and measured epsilon.
plot_error_distribution <- function(result, target_epsilon) {
target_lines <- data.frame(
value = c(target_epsilon, result$measured_epsilon),
label = c(paste0("Target epsilon: ", round(target_epsilon, 3)),
paste0("Measured epsilon: ", round(result$measured_epsilon, 3)))
)
ggplot(result$grid, aes(error)) +
geom_histogram(bins = 30, fill = "#d98050", colour = "white") +
geom_vline(data = target_lines, aes(xintercept = value, colour = label, linetype = label), linewidth = 0.8) +
scale_colour_manual(values = c("#8e2437", "#006d77"), name = NULL) +
scale_linetype_manual(values = c("solid", "dashed"), name = NULL) +
labs(title = "4. Distribution of prediction errors",
subtitle = paste0("All ", format(result$n_grid_cells, big.mark = ","), " grid cells"),
x = "Prediction error = sqrt((inferred - reference)^2)",
y = "Number of grid cells") +
theme_minimal() +
theme(legend.position = "bottom")
}
# ----- EXAMPLE, Part V -------------------------------------------------------
show_points <- TRUE     # FALSE hides the observation points on maps 1 and 2
plot_reference_field(area, field, result, show_points)
plot_inferred_field(area, field, result, show_points)
plot_reference_field(area, field, result, show_points)
plot_reference_field(area, field, result, show_points=F)
plot_inferred_field(area, field, result, show_points=F)
plot_error_map(area, result)
plot_error_distribution(result, epsilon)
plot_reference_field(area, field, result, show_points=F)
plot_inferred_field(area, field, result, show_points=F)
epsilon      <- 0.5    # target prediction error (log scale, 0.05 to 3)
plot_error_map(area, result)
plot_error_distribution(result, epsilon)
